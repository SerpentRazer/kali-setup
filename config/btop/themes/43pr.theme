# Generated by 43pr theme.py from ~/.config/43pr/templates/btop.theme. Do not edit.
# Colors come from the shared semantic palette (presets or Matugen).

# Main background, empty = use terminal default (needed for transparency)
theme[main_bg]="#0d0e0f"

# Main text color
theme[main_fg]="#e3e2e2"

# Title color for boxes
theme[title]="#e3e2e2"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#b8cace"

# Background and foreground color for selected item in processes box
theme[selected_bg]="#292a2a"
theme[selected_fg]="#e3e2e2"

# Color of inactive/disabled text
theme[inactive_fg]="#464747"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#bfc8ca"

# Box outline and divider line colors
theme[cpu_box]="#464747"
theme[mem_box]="#464747"
theme[net_box]="#464747"
theme[proc_box]="#464747"
theme[div_line]="#464747"

# Temperature graph colors
theme[temp_start]="#919191"
theme[temp_mid]="#ffb4ab"
theme[temp_end]="#ffb4ab"

# CPU graph colors
theme[cpu_start]="#919191"
theme[cpu_mid]="#c7c6c6"
theme[cpu_end]="#b8cace"

# Mem/Disk free meter
theme[free_start]="#919191"
theme[free_mid]="#919191"
theme[free_end]="#bacbbf"

# Mem/Disk cached meter
theme[cached_start]="#919191"
theme[cached_mid]="#919191"
theme[cached_end]="#bfc8ca"

# Mem/Disk available meter
theme[available_start]="#919191"
theme[available_mid]="#919191"
theme[available_end]="#c7c6c6"

# Mem/Disk used meter
theme[used_start]="#919191"
theme[used_mid]="#c7c6c6"
theme[used_end]="#b8cace"

# Download graph colors
theme[download_start]="#919191"
theme[download_mid]="#919191"
theme[download_end]="#bfc8ca"

# Upload graph colors
theme[upload_start]="#919191"
theme[upload_mid]="#919191"
theme[upload_end]="#b8cace"
