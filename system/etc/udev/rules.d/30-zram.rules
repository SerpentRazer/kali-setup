# Din CachyOS-Settings (150), coborat la 100 pe 1 nov 2026: la pornirea CS2 kernelul comprima ~3 GB in zram in loc sa arunce cache-ul de fisiere -> sacadari.
ACTION=="change", KERNEL=="zram0", ATTR{initstate}=="1", SYSCTL{vm.swappiness}="100", \
    RUN+="/bin/sh -c 'echo N > /sys/module/zswap/parameters/enabled'"
